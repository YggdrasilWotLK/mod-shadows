# Log on all randombots on start
AiShadow.RandomBotLoginAtStartup = 1

# Guild Task system
AiShadow.EnableGuildTasks = 0

# Enable dungeon suggestions in lower case randomly
AiShadow.SuggestDungeonsInLowerCaseRandomly = 0

# Chance bot chooses RPG (Teleport to random camp for their level) instead of grinding
AiShadow.RandomBotRpgChance = 0.20

# Set randombots movement speed to walking anywhere
AiShadow.RandombotsWalkingRPG = 0

# Set randombots movement speed to walking only inside buildings
AiShadow.RandombotsWalkingRPG.InDoors = 0

# Premade spell to avoid (undetected spells)
# spellid-radius, ...
AiShadow.PremadeAvoidAoe = 62234-4

AiShadow.MinRandomBotsPriceChangeInterval = 7200
AiShadow.MaxRandomBotsPriceChangeInterval = 172800
AiShadow.MinRandomBotChangeStrategyTime = 180
AiShadow.MaxRandomBotChangeStrategyTime = 720

# How often tasks are changed
AiShadow.MinGuildTaskChangeTime = 172800
AiShadow.MaxGuildTaskChangeTime = 432000

# Mail spam interval
AiShadow.MinGuildTaskAdvertisementTime = 300
AiShadow.MaxGuildTaskAdvertisementTime = 28800

# Delay before reward is sent
AiShadow.MinGuildTaskRewardTime = 300
AiShadow.MaxGuildTaskRewardTime = 3600

# Cleanup of guild tasks interval
AiShadow.GuildTaskAdvertCleanupTime = 300

# Specify max distance between victim and bot when creating guild kill task
AiShadow.GuildTaskKillTaskDistance = 200

# Distance margin for facade calculations
AiShadow.TargetPosRecalcDistance = 0.1

# Allow bots to be summoned near innkeepers
AiShadow.SummonAtInnkeepersEnabled = 1

# Enable buffs in ICC to make Heroic easier and more casual.
# 30% more damage, 40% damage reduction (tank bots), increased all resistances, reduced threat for non tank bots, increased threat for tank bots.
# Buffs will be applied on PP, Sindragosa and Lich King

AiShadow.EnableICCBuffs = 1
