#

# Distances are in yards
AiShadow.FarDistance = 20.0
AiShadow.SightDistance = 100.0
AiShadow.SpellDistance = 28.5
AiShadow.ShootDistance = 5.0
AiShadow.HealDistance = 38.5
AiShadow.LootDistance = 15.0
AiShadow.FleeDistance = 5.0
AiShadow.AggroDistance = 22
AiShadow.TooCloseDistance = 5.0
AiShadow.MeleeDistance = 0.75
AiShadow.FollowDistance = 1.5
AiShadow.WhisperDistance = 6000.0
AiShadow.ContactDistance = 0.45
AiShadow.AoeRadius = 10
AiShadow.RpgDistance = 200
AiShadow.GrindDistance = 75.0
AiShadow.ReactDistance = 150.0

