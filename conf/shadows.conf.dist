####################################################################################################
# THRESHOLDS
#
#

# Health/Mana levels
AiShadow.CriticalHealth = 25
AiShadow.LowHealth = 45
AiShadow.MediumHealth = 65
AiShadow.AlmostFullHealth = 85
AiShadow.LowMana = 15
AiShadow.MediumMana = 40
AiShadow.HighMana = 65

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# Bots pick their quest rewards (yes = picks the most useful item, no = list all rewards, ask = pick useful item and lists if multiple)
AiShadow.AutoPickReward = yes

# Sync quests with player (Bots will complete quests the moment you hand them in and will not loot quest items.)
# Default: 1 (enabled)
AiShadow.SyncQuestWithPlayer = 1

# Bots will auto-complete quests for the player when handing in bots' quests
# Default: 0 (disabled)
AiShadow.SyncQuestForPlayer = 0

# Bots will drop obsolete quests
# Default: 1 (enabled)
AiShadow.DropObsoleteQuests = 1

#
#
#
####################################################################################################

####################################################################################################
# COMBAT
#
#

# Auto add dungeon/raid strategies when entering the instance if implemented
AiShadow.ApplyInstanceStrategies = 1

# Enable auto avoid aoe strategy (experimental)
# Default: 1 (enabled)
AiShadow.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
AiShadow.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
AiShadow.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer bot save mana strategy
# Default: 1 (enabled)
AiShadow.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
AiShadow.SaveManaThreshold = 60

# Bots can flee from enemies
AiShadow.FleeingEnabled = 1

#
#
#
####################################################################################################

####################################################################################################
# PALADIN BUFFS STRATEGIES
#
#

# Min group size to use Greater buffs (Paladin, Mage, Druid)
# Default: 3
AiShadow.MinBotsForGreaterBuff = 3

# Cooldown (seconds) between reagent-missing RP warnings, per bot & per buff
# Default: 30
AiShadow.RPWarningCooldown = 30

#
#
#
####################################################################################################

####################################################################################################
# CHEATS
#
#

# Enable/Disable maintenance command
# Learn all available spells and skills, refresh consumables, repair, enchant equipment and socket gems if bot's level is above AiShadow.MinEnchantingBotLevel
# Default: 1 (enabled)
AiShadow.MaintenanceCommand = 1

# Enable/Disable specific maintenance command functionality for alt bots
# Disable to prevent players from giving free bags, spells, skill levels etc to their alt bots
# Default: 1 (enabled)
AiShadow.AltMaintenanceAmmo = 1
AiShadow.AltMaintenanceFood = 1
AiShadow.AltMaintenanceReagents = 1
AiShadow.AltMaintenanceConsumables = 1
AiShadow.AltMaintenancePotions = 1

AiShadow.AltMaintenanceBags = 1
AiShadow.AltMaintenanceMounts = 1
AiShadow.AltMaintenanceSkills = 1

AiShadow.AltMaintenanceClassSpells = 1
AiShadow.AltMaintenanceAvailableSpells = 1
AiShadow.AltMaintenanceSpecialSpells = 1
AiShadow.AltMaintenanceTalentTree = 1
AiShadow.AltMaintenanceGlyphs = 1
AiShadow.AltMaintenanceGemsEnchants = 1

AiShadow.AltMaintenancePet = 1
AiShadow.AltMaintenancePetTalents = 1

AiShadow.AltMaintenanceReputation = 1
AiShadow.AltMaintenanceAttunementQuests = 1
AiShadow.AltMaintenanceKeyring = 1


# Enable/Disable autogear command, which automatically upgrades bots' gear; the quality is limited by AutoGearQualityLimit and AutoGearScoreLimit
# Default: 1 (enabled)
AiShadow.AutoGearCommand = 1

# Enable/Disable autogear command on altbots
# Default: 1 (enabled)
AiShadow.AutoGearCommandAltBots = 1

# Equipment quality limitation for autogear command (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# Default: 3 (rare)
AiShadow.AutoGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for autogear command (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 1.5(ZA) = 138 | Phase 2(SC, TK) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# Wotlk
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
AiShadow.AutoGearScoreLimit = 0

# Enable/Disable cheats for bots
# "food" (bots eat or drink without using food or drinks from their inventory)
# "gold" (bots have infinite gold)
# "health" (bots immediately regenerate lost health)
# "mana" (bots have infinite mana)
# "power" (bots have infinite energy, rage, and runic power)
# "taxi" (bots may use all flight paths, though they will not actually learn them)
# "raid" (bots use cheats implemented into raid strategies (currently only for Ulduar))
# To use multiple cheats, separate them by commas below (e.g., to enable all, use "gold,health,mana,power,raid,taxi")
# Default: food, taxi, and raid are enabled
AiShadow.BotCheats = "food,taxi,raid"

#
#
#
####################################################################################################

####################################################################################################
# FLIGHTPATH
#
#

# Min random delay before the 1st follower bot clicks the flight-master (ms)
AiShadow.BotTaxiDelayMinMs = 350

# Upper bound for the overall taxi delay window (ms) – larger spreads big raids
AiShadow.BotTaxiDelayMaxMs = 5000

# Fixed gap added per group-slot so bots never take off together (ms)
AiShadow.BotTaxiGapMs = 200

# Extra small randomness added to each gap so launches don’t look robotic (ms)
AiShadow.BotTaxiGapJitterMs = 100

#
#
#
####################################################################################################

#######################################
#                                     #
# RANDOMBOT-SPECIFIC SETTINGS  #
#                                     #
#######################################

####################################################################################################
# GENERAL
#
#

# Enable/Disable randomly generated password for randombot accounts
AiShadow.RandomBotRandomPassword = 0

# Prefix for account names to create for randombots
AiShadow.RandomBotAccountPrefix = "rndbot"

# Minimum and maximum levels for randombots
AiShadow.RandomBotMinLevel = 1
AiShadow.RandomBotMaxLevel = 80

# Sync max randombot level with max level of online players
# Default: 0 (disabled)
AiShadow.SyncLevelWithPlayers = 0

# Mark many quests ≤ bot level as complete (slows down bot creation)
# Default: 0 (disabled)
AiShadow.PreQuests = 0

# Enable LFG for randombots
# Default: 1 (enabled)
AiShadow.RandomBotJoinLfg = 1

# Enable/Disable periodic online - offline of randombots to mimic the real-world scenario where not all players are online simultaneously
# When enabled, randombots are randomly selected to go online or offline periodically from a larger set
# Default: 0 (disabled, the set of online bots remains fixed)
AiShadow.EnablePeriodicOnlineOffline = 0

# Defines the ratio between the total number of randombots (including offline ones) and the number of randombots currently online (MaxRandomBots)
# This setting must greater than 1.0 and only applies when EnablePeriodicOnlineOffline
# Default: 2.0 (total number of bots is twice the number of MaxRandomBots)
AiShadow.PeriodicOnlineOfflineRatio = 2.0

# Percentage ratio of Alliance and Horde randombots
AiShadow.RandomBotAllianceRatio = 50
AiShadow.RandomBotHordeRatio = 50

# Disable logging in of death knight bots
AiShadow.DisableDeathKnightLogin = 0

# Enable simulated expansion limitation for talents and glyphs
# If enabled, limits talent trees to 5 rows plus the middle talent of the 6th row for bots until level 61 
# and 7 rows plus the middle talent of the 8th row for bots from level 61 until level 71
# Default: 0 (disabled)
AiShadow.LimitTalentsExpansion = 0

# Configure randombots and addClass bot trading (0: Disabled, 1: Enabled, 2: Only Buy, 3: Only Sell)
# Default: 1 (enabled)
AiShadow.EnableRandomBotTrading = 1

# Configure message prefixes which will be excluded in analysis in trade action to open trade window
AiShadow.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

#
#
#
####################################################################################################

####################################################################################################
# LEVELS
#
#

# Disable randombots being generated with a random level
# If disabled, every randombot starts on a specified level (but can still level up by killing mobs and questing)
AiShadow.DisableRandomLevels = 0

# Set randombots' starting level here if "AiShadow.DisableRandomLevels" enabled
AiShadow.RandombotStartingLevel = 1

# Chance randombot has min level on first randomize
# Default: 0.1 (10%)
AiShadow.RandomBotMinLevelChance = 0.1

# Chance randombot has max level on first randomize
# Default 0.1 (10%)
AiShadow.RandomBotMaxLevelChance = 0.1

# Fix the level of randombots (they won't level up)
# Default: 0 (disabled)
AiShadow.RandomBotFixedLevel = 0

# Set RandomBotMaxLevel bots to RandomBotMinLevel
# Default: 0 (disabled)
AiShadow.DowngradeMaxLevelBot = 0

# Set XP rate for random bots (Default: 1.0)
# Server XP Rate * AiShadow.RandomBotXPRate
AiShadow.RandomBotXPRate = 1.0

#
#
#
####################################################################################################

####################################################################################################
# GEAR
#
#

# Equipment quality limitation for randombots (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# This also sets the maximum quality that can be generated by autogear for randombots and altbots
# Default: 3 (rare)
AiShadow.RandomGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for randombots (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 1.5(ZA) = 138 | Phase 2(SC, TK) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# Wotlk
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
AiShadow.RandomGearScoreLimit = 0

# If disabled, random bots can only upgrade equipment through looting and quests
# Default: 1 (enabled)
AiShadow.IncrementalGearInit = 1

# Set minimum level of bots that will enchant their equipment (if greater than RandomBotMaxlevel, bots will not enchant equipment)
# Default: 60
AiShadow.MinEnchantingBotLevel = 60

# Enable expansion limitation for bot enchants and gems
# If enabled, bots will not use TBC enchants until level 61 or WotLK enchants and gems until level 71
# Default: 1 (enabled)
AiShadow.LimitEnchantExpansion = 1

# Enable expansion limitation for gear
# If enabled, bots will not equip TBC gear until level 61 or WotLK gear until level 71
# Default: 1 (enabled)
AiShadow.LimitGearExpansion = 1

# Chance randombot will have less-than-optimized generated gear
# Set between 0 (0%) and 1 (100%)
AiShadow.RandomGearLoweringChance = 0

# Randombots check player's gearscore level and deny the group invitation if it's too low
# Default: 0 (disabled)
AiShadow.GearScoreCheck = 0

# Enable/Disable bot equipment persistence (stop random initialization) after certain level (EquipmentPersistenceLevel)
# Default: 0 (disabled)
AiShadow.EquipmentPersistence = 0

# Default level if enabled: 80
AiShadow.EquipmentPersistenceLevel = 80

# Randombots automatically upgrade their equipment on levelup
# Default: 1 (enabled)
AiShadow.AutoUpgradeEquip = 1

# Only set wolf pets for hunters for optimal raid performance (0 = disabled, 1 = enabled only for max-level bots, 2 = enabled)
# Default: 0 (disabled)
AiShadow.HunterWolfPet = 0

# Default pet stance when a bot summons a pet
# 0 = Passive, 1 = Defensive, 2 = Aggressive
# Default: 1 (Defensive)
AiShadow.DefaultPetStance = 1

# Enable/disable debug messages about pet commands
# 0 = Disabled, 1 = Enabled
# Default = 0 (disabled)
AiShadow.PetChatCommandDebug = 0

# Prohibit hunter bots from creating pets with any family ID listed below in ExcludedHunterPetFamilies
# See the creature_family database table for all pet families by ID (note: ID for spiders is 3)
AiShadow.ExcludedHunterPetFamilies = ""

#
#
#
####################################################################################################


####################################################################################################
# ACTIVITIES
#
#
# Specify percent of active bots
# The default is 100% but will be automatically adjusted if botActiveAloneSmartScale
# is enabled. Regardless, this value is only applied to inactive areas where no real players
# are detected. When real players are nearby, the value is always enforced to 100%
AiShadow.BotActiveAlone = 100

# Force botActiveAlone when bot is within the specified distance of a real player
AiShadow.BotActiveAloneForceWhenInRadius = 150
AiShadow.BotActiveAloneForceWhenInZone = 1
AiShadow.BotActiveAloneForceWhenInMap = 0
AiShadow.BotActiveAloneForceWhenIsFriend = 1
AiShadow.BotActiveAloneForceWhenInGuild = 1

# SmartScale (automatic scaling of percentage of active bots based on latency)
# The default is 1. When enabled (smart) scales the 'BotActiveAlone' value.
# (The scaling will be overruled by the BotActiveAloneForceWhen...rules)
#
#   Limitfloor - when DIFF (latency) is above floor, activity scaling begins
#   LimitCeiling - when DIFF (latency) is above ceiling, activity is 0%
#
#   MinLevel - only apply scaling when level is above or equal to min(bot)Level
#   MaxLevel - only apply scaling when level is lower or equal of max(bot)Level
#
AiShadow.botActiveAloneSmartScale = 1
AiShadow.botActiveAloneSmartScaleDiffLimitfloor = 50
AiShadow.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiShadow.botActiveAloneSmartScaleWhenMinLevel = 1
AiShadow.botActiveAloneSmartScaleWhenMaxLevel = 80

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# Quest that will be completed and rewarded for all randombots
AiShadow.RandomBotQuestIds = "3802,5505,6502,7761,7848,10277,10285,11492,13188,13189,24499,24511,24710,24712"

# Randombots will group with nearby randombots to do shared quests
AiShadow.RandomBotGroupNearby = 0

# Randombots will pick quests on their own and try to complete them
# Default: 1 (enabled)
AiShadow.AutoDoQuests = 1

# Quest items to keep in bots' inventories (do not destroy)
AiShadow.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# Randombots automatically learn class quest reward spells on levelup
# Default: 0 (disabled)
AiShadow.AutoLearnQuestSpells = 0

# Randombots automatically learn trainable spells on levelup
# Default: 1 (enabled)
AiShadow.AutoLearnTrainerSpells = 1

# Randombots automatically spend talent points on levelup
# Default: 1 (enabled)
AiShadow.AutoPickTalents = 1

# Spells every randombot will learn automatically and every altbot will learn with maintenance (54197 - cold weather flying)
AiShadow.RandomBotSpellIds = "54197"

# ID of spell to open lootable chests
AiShadow.OpenGoSpell = 6477

#
#
#
####################################################################################################

####################################################################################################
# STRATEGIES
#
#

# Additional randombot strategies
# Strategies added here are applied to all randombots, in addition (or subtraction) to spec/role-based default strategies. These rules are processed after the defaults.
# Example: "+threat,-potions"
AiShadow.RandomBotCombatStrategies = ""
AiShadow.RandomBotNonCombatStrategies = ""

# Additional altbot strategies
# Strategies added here are applied to all altbots, in addition (or subtraction) to spec/role-based default strategies. These rules are processed after the defaults.
AiShadow.CombatStrategies = ""
AiShadow.NonCombatStrategies = ""

# Remove "healer dps" strategy on the maps specified below.
# Default: 1 (enabled)
AiShadow.HealerDPSMapRestriction = 1

# List of Map IDs where "healer dps" strategy will be removed if AiShadow.HealerDPSMapRestriction is enabled
# Default: (Dungeon and Raid maps) "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724"
AiShadow.RestrictedHealerDPSMaps = "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724"

#
#
#
####################################################################################################

####################################################################################################
# RPG STRATEGY
#
#

# Randombots will behave more like real players (experimental)
# This option will override AiShadow.AutoDoQuests, RandomBotTeleLowerLevel, and RandomBotTeleHigherLevel
# Default: 1 (enabled)
AiShadow.EnableNewRpgStrategy = 1

# Control probability weights for RPG status of bots. Takes effect only when the status meets its premise.​
# Sum of weights need not be 100. Set to 0 to disable the status.
#
# WanderRandom  (Default: 15  Move randomly nearby to find and kill mobs)
# WanderNpc     (Default: 20  Randomly interact with nearby NPCs​)
# GoGrind       (Default: 15  Go to nearby level-appropriate locations to grind for killing mobs)
# GoCamp        (Default: 10  Return to a nearby camp depending on innkeeper/flightmaster)​
# DoQuest       (Default: 60  Select quest from the quest log and head to the location to attempt completion​)
# TravelFlight  (Default: 15  Go to the nearest flightmaster and fly to a level-appropriate area)
# Rest          (Default: 5   Take a break for a while and do nothing)
AiShadow.RpgStatusProbWeight.WanderRandom = 15
AiShadow.RpgStatusProbWeight.WanderNpc = 20
AiShadow.RpgStatusProbWeight.GoGrind = 15
AiShadow.RpgStatusProbWeight.GoCamp = 10
AiShadow.RpgStatusProbWeight.DoQuest = 60
AiShadow.RpgStatusProbWeight.TravelFlight = 15
AiShadow.RpgStatusProbWeight.Rest = 5

