#

#    ShadowsDatabaseInfo
#        Description: Database connection settings for the shadows server.
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Use named pipes on Windows
#                                                                 "enable-named-pipe" to [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (use Unix sockets on
#                                                                           Unix/Linux)
#        Default:     "127.0.0.1;3306;acore;acore;acore_shadows"       - (ShadowDatabaseInfo)

ShadowsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_shadows"

#
#    ShadowsDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#                     MySQL server and their own thread on the MySQL server.
#        Default:     1 - (ShadowsDatabase.WorkerThreads)

ShadowsDatabase.WorkerThreads     = 1

#
#    ShadowsDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle.
#        Default:     1 - (ShadowDatabase.WorkerThreads)

ShadowsDatabase.SynchThreads     = 1

#    Shadow.Updates.EnableDatabases
#        Description: Determined if updates system work with shadows database.
#
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Shadows.Updates.EnableDatabases = 1

# Command server port, 0 - disabled
AiShadow.CommandServerPort = 8888

#
#
#
####################################################################################################

####################################################################################################
# DEBUG SWITCHES
#
#

AiShadow.SpellDump = 0
AiShadow.LogInGroupOnly = 1
AiShadow.LogValuesPerTick = 0
AiShadow.RandomChangeMultiplier = 1

# Tell which spell is avoiding (experimental)
# Default: 0 (disabled)
AiShadow.TellWhenAvoidAoe = 0

# Enable/Disable performance monitor
AiShadow.PerfMonEnabled = 0

#
#
#
####################################################################################################

####################################################################################################
# CHAT SETTINGS
#
#

# Prefix for bot chat commands (e.g., follow, stay)
AiShadow.CommandPrefix = ""

# Separator for bot chat commands
AiShadow.CommandSeparator = "\\\\"

# Enable bots talking (say / yell / general chatting / lfg)
AiShadow.RandomBotTalk = 1
# Enable bots emoting
AiShadow.RandomBotEmote = 0
# Enable randombots suggesting dungeons in chat
AiShadow.RandomBotSuggestDungeons = 1
# Bots greet players when invited
AiShadow.EnableGreet = 0
# Chance to reply to toxic links with toxic links (0-100)
AiShadow.ToxicLinksRepliesChance = 30
# Chance to reply to Thunderfury with Thunderfury (0-100)
AiShadow.ThunderfuryRepliesChance = 40
# Enable bots chatting in guild about certain events
AIShadow.GuildFeedback = 1
# Chance bots will chat in guild about certain events (int) (0-100)
AiShadow.GuildRepliesRate = 100
# Bots without a master will say their lines
AiShadow.RandomBotSayWithoutMaster = 0

#
#
#
####################################################################################################

####################################################################################################
# Broadcast rates
#
#

# Enable/disable broadcasts globally
# Default: 1 (enabled)
AiShadow.EnableBroadcasts = 1
#
# All broadcast chances should be in range 0-30000
# Value of 0 will disable this particular broadcast
# Setting value to 30000 does not guarantee the broadcast, as there are some internal randoms as well
#
# Setting channel broadcast chance to 0, will re-route most broadcasts to other available channels
# Setting all channel broadcasts to 0 will disable most broadcasts
AiShadow.BroadcastToGuildGlobalChance = 30000
AiShadow.BroadcastToWorldGlobalChance = 30000
AiShadow.BroadcastToGeneralGlobalChance = 30000
AiShadow.BroadcastToTradeGlobalChance = 30000
AiShadow.BroadcastToLFGGlobalChance = 30000
AiShadow.BroadcastToLocalDefenseGlobalChance = 30000
AiShadow.BroadcastToWorldDefenseGlobalChance = 30000
AiShadow.BroadcastToGuildRecruitmentGlobalChance = 30000
#
# Individual settings
# Setting one of these to 0 will disable the particular broadcast
AiShadow.BroadcastChanceLootingItemPoor = 30
AiShadow.BroadcastChanceLootingItemNormal = 150
AiShadow.BroadcastChanceLootingItemUncommon = 10000
AiShadow.BroadcastChanceLootingItemRare = 20000
AiShadow.BroadcastChanceLootingItemEpic = 30000
AiShadow.BroadcastChanceLootingItemLegendary = 30000
AiShadow.BroadcastChanceLootingItemArtifact = 30000
#
AiShadow.BroadcastChanceQuestAccepted = 6000
AiShadow.BroadcastChanceQuestUpdateObjectiveCompleted = 300
AiShadow.BroadcastChanceQuestUpdateObjectiveProgress = 300
AiShadow.BroadcastChanceQuestUpdateFailedTimer = 300
AiShadow.BroadcastChanceQuestUpdateComplete = 1000
AiShadow.BroadcastChanceQuestTurnedIn = 10000
#
AiShadow.BroadcastChanceKillNormal = 30
AiShadow.BroadcastChanceKillElite = 300
AiShadow.BroadcastChanceKillRareelite = 3000
AiShadow.BroadcastChanceKillWorldboss = 20000
AiShadow.BroadcastChanceKillRare = 10000
AiShadow.BroadcastChanceKillUnknown = 100
AiShadow.BroadcastChanceKillPet = 10
AiShadow.BroadcastChanceKillPlayer = 30
#
AiShadow.BroadcastChanceLevelupGeneric = 20000
AiShadow.BroadcastChanceLevelupTenX = 30000
AiShadow.BroadcastChanceLevelupMaxLevel = 30000
#
AiShadow.BroadcastChanceSuggestInstance = 5000
AiShadow.BroadcastChanceSuggestQuest = 10000
AiShadow.BroadcastChanceSuggestGrindMaterials = 5000
AiShadow.BroadcastChanceSuggestGrindReputation = 5000
AiShadow.BroadcastChanceSuggestSell = 300
AiShadow.BroadcastChanceSuggestSomething = 30000
#
# Bots will say very rude things
AiShadow.BroadcastChanceSuggestSomethingToxic = 0
#
# Specifically for "<word> [item link]"
AiShadow.BroadcastChanceSuggestToxicLinks = 0
#
# Prefix is used as a word in "<word> [item link]"
AiShadow.ToxicLinksPrefix = gnomes
#
# Chance to suggest Thunderfury
AiShadow.BroadcastChanceSuggestThunderfury = 1
#
# Does not depend on global chance
AiShadow.BroadcastChanceGuildManagement = 30000
